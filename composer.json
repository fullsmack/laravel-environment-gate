{
    "name": "fullsmack/laravel-environment-gate",
    "description": "Lock staging, demo and preview environments behind a shareable access gate, without maintenance mode. Built for Laravel Vapor, works anywhere.",
    "keywords": ["laravel", "vapor", "staging", "demo", "access", "gate", "middleware", "password-protection", "environment"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolai Baaring"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cookie": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "fullsmack/php-cs-fixer-breathe": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "FullSmack\\EnvironmentGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FullSmack\\EnvironmentGate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FullSmack\\EnvironmentGate\\EnvironmentGateServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
